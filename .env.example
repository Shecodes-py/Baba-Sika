# Copy to .env and fill in. Nothing here is committed to git.

DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
DJANGO_TIME_ZONE=Africa/Lagos

# Leave unset to use sqlite for local dev. Example for Postgres:
# DATABASE_URL=postgres://user:password@localhost:5432/babasika
DATABASE_URL=

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Bank + PFA providers ---
# Neither Wema nor any PFA has a confirmed API integration yet - both
# default to their mock implementation (see account_provisioning.providers
# and pensions.providers). Leave these unset until a real partnership lands.
BANK_PROVIDER_BACKEND=
PFA_PROVIDER_BACKEND=

# Tune the mock providers' simulated latency/failure rate (0.0-1.0). Set
# MOCK_PROVIDER_FAILURE_RATE=0 for deterministic testing.
MOCK_PROVIDER_FAILURE_RATE=0.1
MOCK_PROVIDER_MIN_LATENCY_MS=200
MOCK_PROVIDER_MAX_LATENCY_MS=900

# --- AI provider ---
# Leave GEMINI_API_KEY unset to run entirely on the deterministic stub
# provider (useful for demos / avoiding rate limits).
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash
AI_PROVIDER_BACKEND=

# --- Twilio WhatsApp ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# --- Dashboard handoff ---
DASHBOARD_BASE_URL=https://dashboard.babasika.ng
